# Little Dreamer — environment template
#
# Copy to .env.local (Next.js) and/or .env (Prisma CLI) and fill in.
# NEVER commit real values. .gitignore excludes .env* except this file.
#
# NOTE: nothing here is consumed by the landing page. Every variable below
# belongs to the app phase and is documented now so the scaffold is complete.

# ─── Database (Neon + Prisma 7 driver adapter) ───────────────────────────────
# Prisma 7 reads this via prisma.config.ts, not via the datasource block.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# Server-side only. These must never reach the browser or Make.com — Make
# receives short-lived presigned URLs instead.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="little-dreamer"
R2_PUBLIC_BASE_URL=""

# ─── Make.com automation ─────────────────────────────────────────────────────
# Scenario 6695966 "Little Dream", team 2123206, zone eu1.
MAKE_WEBHOOK_URL="https://hook.eu1.make.com/REPLACE_ME"
MAKE_API_KEY=""

# Signs callbacks from Make back into /api/webhooks/make/[event].
MAKE_CALLBACK_HMAC_SECRET=""

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Absent = email is skipped, not faked. The UI says "Saved" instead of "Sent".
RESEND_API_KEY=""
# Must be a domain verified in Resend. onboarding@resend.dev works for testing
# but only delivers to the Resend account owner's own address.
RESEND_FROM="Little Dreamer <hello@yourdomain.com>"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Publicly reachable base URL for Make -> app callbacks. Make runs in the
# cloud and cannot see localhost; use an ngrok/cloudflared URL in development.
# Left empty, the callback is omitted from the payload entirely and Make's
# filtered callback module simply skips.
PUBLIC_CALLBACK_URL=""
